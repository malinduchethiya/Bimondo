rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL DEFAULT-DENY SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. REUSABLE HARDENED PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Enforces verified Firebase ID token custom claim: admin === true
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAllowedSectionDocId(docId) {
      return docId in [
        'shared_header',
        'shared_footer',
        'shared_whatsapp',
        'home_hero',
        'home_transition',
        'home_story',
        'home_bento',
        'home_experience',
        'home_places',
        'home_reviews',
        'home_planning_faq',
        'home_contact',
        'destinations_page',
        'destinations_catalog',
        'packages_page',
        'packages_tours',
        'stays_page',
        'stays_catalog',
        'gallery_page',
        'our_story_page',
        'contact_page',
        'booking_page'
      ];
    }

    function isValidCmsSectionDocument(data, docId) {
      return data.keys().hasAll([
          'docId',
          'pageId',
          'title',
          'revision',
          'deleted',
          'deletedAt',
          'deletedBy',
          'createdAt',
          'updatedAt',
          'updatedBy',
          'payload'
        ]) &&
        data.keys().hasOnly([
          'docId',
          'pageId',
          'title',
          'revision',
          'deleted',
          'deletedAt',
          'deletedBy',
          'createdAt',
          'updatedAt',
          'updatedBy',
          'payload'
        ]) &&
        data.docId is string &&
        data.docId.size() >= 1 &&
        data.docId.size() <= 64 &&
        data.docId == docId &&
        isAllowedSectionDocId(data.docId) &&
        data.pageId is string &&
        data.pageId.size() >= 1 &&
        data.pageId.size() <= 64 &&
        data.pageId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 160 &&
        data.revision is int &&
        data.revision >= 1 &&
        data.deleted is bool &&
        (data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 64)) &&
        (data.deletedBy == null || (data.deletedBy is string && data.deletedBy.size() <= 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        data.updatedBy is string &&
        data.updatedBy.size() >= 1 &&
        data.updatedBy.size() <= 128 &&
        data.updatedBy == request.auth.uid &&
        data.payload is map &&
        data.payload.size() >= 1 &&
        data.payload.size() <= 20;
    }

    function isValidCustomerEnquiry(data, enquiryId) {
      return data.keys().hasAll([
          'id',
          'name',
          'email',
          'phone',
          'bookingMethod',
          'selectedPackage',
          'arrival',
          'guests',
          'duration',
          'style',
          'message',
          'status',
          'adminNotes',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'email',
          'phone',
          'bookingMethod',
          'selectedPackage',
          'arrival',
          'guests',
          'duration',
          'style',
          'message',
          'status',
          'adminNotes',
          'createdAt'
        ]) &&
        data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id == enquiryId &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.phone is string &&
        data.phone.size() <= 64 &&
        data.bookingMethod is string &&
        data.bookingMethod in ['direct_admin', 'whatsapp', 'email', 'callback', 'manual'] &&
        data.selectedPackage is string &&
        data.selectedPackage.size() <= 160 &&
        data.arrival is string &&
        data.arrival.size() >= 1 &&
        data.arrival.size() <= 64 &&
        data.guests is string &&
        data.guests.size() >= 1 &&
        data.guests.size() <= 64 &&
        data.duration is string &&
        data.duration.size() >= 1 &&
        data.duration.size() <= 64 &&
        data.style is string &&
        data.style.size() >= 1 &&
        data.style.size() <= 120 &&
        data.message is string &&
        data.message.size() <= 2000 &&
        data.status is string &&
        data.status in ['new', 'in_progress', 'replied', 'archived'] &&
        data.adminNotes is string &&
        data.adminNotes.size() <= 2000 &&
        data.createdAt is timestamp;
    }

    function isValidMediaObjectRecord(data, mediaId) {
      return data.keys().hasAll([
          'id',
          'objectKey',
          'status',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'id',
          'objectKey',
          'status',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id == mediaId &&
        data.objectKey is string &&
        data.objectKey.size() >= 1 &&
        data.objectKey.size() <= 512 &&
        data.status is string &&
        data.status in ['active', 'deleting', 'deleted'] &&
        data.updatedAt is timestamp &&
        data.updatedBy is string &&
        data.updatedBy.size() >= 1 &&
        data.updatedBy.size() <= 128 &&
        data.updatedBy == request.auth.uid;
    }

    // =========================================================================
    // 2. PUBLIC WEBSITE CONTENT SECTIONS (/cms_sections/{docId})
    // =========================================================================
    // - Public visitors can read published website content sections without signing in.
    // - Only authenticated administrators (request.auth.token.admin == true) can
    //   create, update, or delete section documents.
    match /cms_sections/{docId} {
      allow get: if isValidId(docId) && isAllowedSectionDocId(docId);
      allow list: if true;

      allow create: if isAdmin() &&
        isValidId(docId) &&
        isValidCmsSectionDocument(incoming(), docId) &&
        incoming().revision == 1 &&
        incoming().createdAt == request.time;

      allow update: if isAdmin() &&
        isValidId(docId) &&
        isValidCmsSectionDocument(incoming(), docId) &&
        incoming().docId == existing().docId &&
        incoming().pageId == existing().pageId &&
        incoming().createdAt == existing().createdAt &&
        incoming().revision == existing().revision + 1 &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'revision',
          'deleted',
          'deletedAt',
          'deletedBy',
          'updatedAt',
          'updatedBy',
          'payload'
        ]);

      allow delete: if isAdmin() && isValidId(docId) && isAllowedSectionDocId(docId);
    }

    // =========================================================================
    // 3. PRIVATE CUSTOMER ENQUIRIES (/customer_enquiries/{enquiryId})
    // =========================================================================
    // - Contains customer PII (email, phone, travel notes); NEVER publicly readable.
    // - Public visitors can submit a new validated enquiry (status == 'new').
    // - Only authenticated administrators (request.auth.token.admin == true) can
    //   read, list, update, or delete enquiries.
    match /customer_enquiries/{enquiryId} {
      allow get: if isAdmin() && isValidId(enquiryId);
      allow list: if isAdmin();

      allow create: if isValidId(enquiryId) &&
        isValidCustomerEnquiry(incoming(), enquiryId) &&
        incoming().status == 'new' &&
        incoming().adminNotes == '' &&
        incoming().createdAt == request.time;

      allow update: if isAdmin() &&
        isValidId(enquiryId) &&
        isValidCustomerEnquiry(incoming(), enquiryId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'adminNotes'
        ]);

      allow delete: if isAdmin() && isValidId(enquiryId);
    }

    // =========================================================================
    // 4. R2 MEDIA OBJECT LIFECYCLE RECORDS (/media_objects/{mediaId})
    // =========================================================================
    // - Tracks active / deleting / deleted lifecycle status of R2 objects so
    //   concurrent content saves cannot assign an object while it is being deleted.
    // - Only authenticated administrators (request.auth.token.admin == true) can
    //   read, list, create, update, or delete lifecycle records.
    match /media_objects/{mediaId} {
      allow get: if isAdmin() && isValidId(mediaId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(mediaId) &&
        isValidMediaObjectRecord(incoming(), mediaId);

      allow update: if isAdmin() &&
        isValidId(mediaId) &&
        isValidMediaObjectRecord(incoming(), mediaId) &&
        incoming().id == existing().id &&
        incoming().objectKey == existing().objectKey;

      allow delete: if isAdmin() && isValidId(mediaId);
    }
  }
}

