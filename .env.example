# ==============================================================================
# 1. FIREBASE WEB CONFIGURATION (Frontend Client SDK — Safe for Public Browser)
# ==============================================================================
# Pre-configured via firebase-applet-config.json; optional env overrides below.
# Admin access is enforced via custom claim (admin === true) or verified admin email.
NEXT_PUBLIC_FIREBASE_PROJECT_ID="advance-sandbox-gmzf6"
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-bimondotravels-99e233ba-6878-4a9b-b4e4-291cc3474a9a"

# ==============================================================================
# 2. ONE-TIME ADMIN CLAIM & CONTENT IMPORT CLI SCRIPTS (Local / Trusted Server ONLY)
# ==============================================================================
# NEVER prefix service account credentials with NEXT_PUBLIC_ or commit key files.
# Used when running:
#   node scripts/grant-admin-claim.mjs <FIREBASE_USER_UID>
#   node scripts/init-firestore-content.mjs
FIREBASE_PROJECT_ID="advance-sandbox-gmzf6"
FIRESTORE_DATABASE_ID="ai-studio-bimondotravels-99e233ba-6878-4a9b-b4e4-291cc3474a9a"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account-key.json"

# ==============================================================================
# 3. CLOUDFLARE R2 MEDIA STORAGE & PUBLIC CDN
# ==============================================================================
# Public base URL for serving uploaded images via the R2 bucket's Custom Domain
# (`BIMONDO_IMAGES` R2 binding on Cloudflare Worker `bimondo` -> `cdn.bimondotours.com`):
NEXT_PUBLIC_IMAGE_BASE_URL="https://cdn.bimondotours.com"
PUBLIC_IMAGE_BASE_URL="https://cdn.bimondotours.com"
# Media uploads, listings, and deletions run via authenticated server-side routes:
#   POST /api/media/upload
#   GET  /api/media
#   POST /api/media/delete
#   GET  /api/media/health
# Bound directly to env.BIMONDO_IMAGES in wrangler.toml (no browser R2 secrets).

# ==============================================================================
# 4. APPLICATION & SERVER ENVIRONMENT
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://www.bimondotours.com"
