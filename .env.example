# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://www.bimondotours.com"

# ============================================================================
# CLOUDFLARE R2 MEDIA STORAGE (SERVER-SIDE AUTHORITATIVE CONFIGURATION)
# ============================================================================
# All R2 credentials and bucket settings are read exclusively on the server.
# Never expose R2 credentials with NEXT_PUBLIC_ prefixes or browser headers.
#
# 1. OpenNext Cloudflare Worker Runtime (Production on Cloudflare):
#    - Bind your R2 bucket in wrangler.jsonc / Cloudflare Worker Settings as:
#        binding = "R2_MEDIA_BUCKET" (or "R2_BUCKET")
#        bucket_name = "bimondo"
#    - Set plain environment variables on the Worker:
#        R2_BUCKET_NAME="bimondo"
#        R2_PUBLIC_CDN_URL="https://cdn.bimondotours.com"
#      (If you attach and activate https://cdn.bimondotravels.com on the
#       "bimondo" bucket in Cloudflare R2 -> Settings -> Custom Domains,
#       update R2_PUBLIC_CDN_URL="https://cdn.bimondotravels.com" after
#       verifying a test object URL returns HTTP 200 image/*.)
#
# 2. Node.js / AI Studio Preview Runtime (@aws-sdk/client-s3):
#    - Uses https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com with region "auto"
#      (or R2_JURISDICTION / R2_ENDPOINT if the bucket uses a jurisdiction).
#    - Set the following server environment variables / secrets:
R2_ACCOUNT_ID="cb757d11edf7dc64fc682ae735992ba4"
R2_BUCKET_NAME="bimondo"
R2_PUBLIC_CDN_URL="https://cdn.bimondotours.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional jurisdiction or custom S3 endpoint (leave blank for standard global R2):
R2_JURISDICTION=""
R2_ENDPOINT=""
