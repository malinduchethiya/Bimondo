# ==============================================================================
# 1. FIREBASE WEB CONFIGURATION (Frontend Client SDK — Safe for Public Browser)
# ==============================================================================
# Required by Next.js to initialize Firebase Authentication & Cloud Firestore.
# These values identify your Firebase project; they do NOT grant admin privileges.
# Admin access is enforced via a verified Firebase ID token custom claim (admin === true).
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy_YOUR_FIREBASE_WEB_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:abcdef1234567890"
# Optional named Firestore database ID (leave empty or "(default)" for default DB)
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# ==============================================================================
# 2. ONE-TIME ADMIN CLAIM & CONTENT IMPORT CLI SCRIPTS (Local / Trusted Server ONLY)
# ==============================================================================
# NEVER prefix service account credentials with NEXT_PUBLIC_ or commit key files.
# Used when running:
#   node scripts/grant-admin-claim.mjs <FIREBASE_USER_UID>
#   node scripts/init-firestore-content.mjs
FIREBASE_PROJECT_ID="your-project-id"
FIRESTORE_DATABASE_ID="(default)"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account-key.json"

# ==============================================================================
# 3. CLOUDFLARE R2 IMAGE UPLOAD WORKER & PUBLIC CDN (Frontend Client Config)
# ==============================================================================
# Public base URL for serving uploaded images via the R2 bucket's Custom Domain:
NEXT_PUBLIC_IMAGE_BASE_URL="https://cdn.bimondotours.com"
# Deployed Cloudflare Worker base URL for authenticated POST /upload requests
# (Never use the CDN domain as the upload endpoint; do NOT put R2 keys here):
NEXT_PUBLIC_R2_UPLOAD_WORKER_URL="https://bimondo-r2-upload-worker.<your-subdomain>.workers.dev"

# ==============================================================================
# 4. APPLICATION & SERVER ENVIRONMENT
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://www.bimondotours.com"
